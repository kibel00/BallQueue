<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BallQueue.Views.PlayersPage"
             Title="Jugadores y pagos">

    <Grid RowDefinitions="Auto,*" Padding="10">

        <!-- Player Registration -->
        <Frame Grid.Row="0" BorderColor="#e0e0e0" Padding="15" CornerRadius="10" Margin="0,0,0,10">
            <VerticalStackLayout Spacing="10">
                <Label Text="Registrar jugador nuevo" FontSize="16" FontAttributes="Bold" />

                <Entry x:Name="PlayerNameEntry"
                       Placeholder="Nombre del jugador"
                       PlaceholderColor="#999999" />

                <Button Text="Registrar jugador"
                        Clicked="OnRegisterPlayer"
                        BackgroundColor="#4CAF50"
                        TextColor="White" />
            </VerticalStackLayout>
        </Frame>

        <!-- Players List -->
        <Frame Grid.Row="1" BorderColor="#e0e0e0" Padding="0" CornerRadius="10">
            <CollectionView x:Name="PlayersCollectionView" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#f0f0f0" Padding="10" CornerRadius="5" Margin="5">
                            <Grid ColumnDefinitions="*,100" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="3">
                                    <Label Text="{Binding Path=Name, StringFormat='#{0}'}" 
                                           FontSize="14" 
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding Path=ArrivalNumber, StringFormat='Llegada: #{0}'}" 
                                           FontSize="11" 
                                           Opacity="0.7" />
                                    <Label FontSize="11">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding HasPaid}" Value="True">
                                                <Setter Property="Label.Text" Value="Estado: Pagado" />
                                                <Setter Property="Label.TextColor" Value="#4CAF50" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding HasPaid}" Value="False">
                                                <Setter Property="Label.Text" Value="Estado: Sin pagar" />
                                                <Setter Property="Label.TextColor" Value="#F44336" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>

                                <Button Grid.Column="1"
                                        Text="Pagar RD$100"
                                        FontSize="10"
                                        Padding="5"
                                        BackgroundColor="#FF9800"
                                        TextColor="White"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnPaymentClicked" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Frame>
    </Grid>

</ContentPage>
